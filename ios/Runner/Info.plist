<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>ElectricAutomaticChile</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>ElectricAutomaticChile</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<!-- M-03: App Transport Security explícito -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<false/>
	</dict>

	<!-- ============================================================= -->
	<!-- FCM / Push notifications (iOS)                                -->
	<!--                                                               -->
	<!-- Background modes necesarios para recibir push y data messages -->
	<!-- mientras la app está en background.                           -->
	<!-- ============================================================= -->
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
		<string>remote-notification</string>
	</array>

	<!-- PENDIENTE DEL FUNDADOR (requiere cuenta Apple Developer de pago):
	     1. En Xcode → Runner → Signing & Capabilities: agregar la capability
	        "Push Notifications" y "Background Modes" (marcar Remote notifications).
	        Esto genera/actualiza ios/Runner/Runner.entitlements con:
	            aps-environment = development (o production)
	     2. En el Apple Developer Portal: crear una APNs Authentication Key (.p8)
	        y subirla en la consola de Firebase → Project Settings → Cloud Messaging
	        (sección Apple app configuration).
	     3. Colocar ios/Runner/GoogleService-Info.plist (descargado de Firebase).
	     Ver FIREBASE_SETUP.md. -->

	<!-- Opcional: si prefieres manejar el APNs token manualmente en AppDelegate,
	     puedes desactivar el swizzling de Firebase con:
	     <key>FirebaseAppDelegateProxyEnabled</key><false/>
	     Por defecto lo dejamos activado (recomendado). -->
</dict>
</plist>
